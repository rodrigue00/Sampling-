{
  "file_path": "data/dataP/preprocessed_iris_dataset.csv",
  "random_state": 0,

  "sampling": {
    "enabled": true,
    "fraction": 0.2,

    "gmm": {
      "enabled": false,
      "n_components_range": [1, 2, 3, 4, 5],
      "covariance_types": ["full", "tied", "diag", "spherical"]
    },

    "random": {
      "enabled": false
    },

    "ddbs": {
      "enabled": true,
      "percentage_per_class": 0.2,
      "distance_metric": "euclidean",
      "distribution_type": "geometric"
    }
  },

  "train_test_split": {
    "enabled": true,
    "test_size": 0.2
  },

  "models": {
    "Decision Tree": {
      "enabled": false,
      "max_depth": 10
    },
    "Random Forest": {
      "enabled": false,
      "n_estimators": 100,
      "max_depth": 15
    },
    "SVM": {
      "enabled": false,
      "C": 1.0,
      "kernel": "rbf"
    },
    "Neural Network": {
      "enabled": false,
      "hidden_layer_sizes": [100],
      "learning_rate_init": 0.001
    },
    "XGBoost": {
      "enabled": true,
      "n_estimators": 100,
      "max_depth": 6,
      "learning_rate": 0.1
    }
  },

  "use_optuna": true,
  "n_trials": 50,

  "retrain_with_best_params": true,

  "save_best_model": false,
  "model_save_path": "best_model.pkl",
  "target_column": "species",

  "num_iterations": 2
}
